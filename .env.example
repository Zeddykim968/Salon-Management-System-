# ============================================================================
# Salon Platform — environment template.
# Copy to `.env` at the repo root. ONE file configures both apps:
#   Django reads it directly; Next.js loads it via next.config.ts.
# On Render, paste the same values into the service Environment tab.
# ============================================================================

DEBUG=True                            # False on Render
DJANGO_SECRET_KEY=                    # python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
API_PORT=8000

# Render → your Postgres → External Database URL (starts with postgresql://)
DATABASE_URL=postgresql://salon:salon@localhost:5432/salon

FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1     # add https://your-app.onrender.com in prod
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional locally (log instead of send); required for real delivery in prod
RESEND_API_KEY=
EMAIL_FROM=Salon <hello@yourdomain.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional locally (files go to backend/media); set for prod image hosting
CLOUDINARY_URL=

TIME_ZONE=Africa/Nairobi
